{
  "mcpServers": {
    "edel-mainnet": {
      "type": "http",
      "url": "https://mcp.edel-api.xyz/mcp",
      "bearer_token_env_var": "EDEL_MCP_KEY_MAINNET",
      "headers": {
        "Authorization": "Bearer ${EDEL_MCP_KEY_MAINNET}"
      }
    },
    "edel-development": {
      "type": "http",
      "url": "https://mcp-dev.edel-api.xyz/mcp",
      "bearer_token_env_var": "EDEL_MCP_KEY_DEVELOPMENT",
      "headers": {
        "Authorization": "Bearer ${EDEL_MCP_KEY_DEVELOPMENT}"
      }
    },
    "edel-testnet": {
      "type": "http",
      "url": "https://mcp-testnet.edel-api.xyz/mcp",
      "bearer_token_env_var": "EDEL_MCP_KEY_TESTNET",
      "headers": {
        "Authorization": "Bearer ${EDEL_MCP_KEY_TESTNET}"
      }
    }
  }
}
