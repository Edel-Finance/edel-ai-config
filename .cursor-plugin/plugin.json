{
  "name": "edel",
  "version": "1.1.0",
  "description": "Edel PERPS public API skill plus the public Edel MCP for Development and TestNet, authenticated with your own API key.",
  "author": { "name": "Edel Finance" },
  "homepage": "https://docs.edel.finance/developers/accounts/for-agents",
  "repository": "https://github.com/Edel-Finance/edel-ai-config",
  "license": "MIT",
  "keywords": ["edel", "perps", "trading", "canton", "mcp"],
  "skills": "./skills/",
  "variables": {
    "type": "object",
    "properties": {
      "EDEL_MCP_KEY_DEVELOPMENT": {
        "type": "string",
        "description": "Your own Edel API key for Development, approved with your passkey."
      },
      "EDEL_MCP_KEY_TESTNET": {
        "type": "string",
        "description": "Your own Edel API key for TestNet, approved with your passkey."
      }
    }
  },
  "mcpServers": {
    "edel-development": {
      "url": "https://mcp-dev.edel-api.xyz/mcp",
      "headers": { "Authorization": "Bearer ${EDEL_MCP_KEY_DEVELOPMENT}" }
    },
    "edel-testnet": {
      "url": "https://mcp-testnet.edel-api.xyz/mcp",
      "headers": { "Authorization": "Bearer ${EDEL_MCP_KEY_TESTNET}" }
    }
  }
}
