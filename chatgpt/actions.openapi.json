{
  "openapi": "3.1.0",
  "info": {
    "title": "Edel public market data (v2)",
    "version": "2.0.0",
    "description": "Read-only public v2 routes of the Edel REST API (Spot, Perps and Common). Source of truth: GET /openapi.json on the same origin."
  },
  "servers": [
    {
      "url": "https://mainnet.edel-api.xyz",
      "description": "MainNet. For tests, use https://testnet.edel-api.xyz instead."
    }
  ],
  "paths": {
    "/v2/system/status": {
      "get": {
        "operationId": "getSystemStatusV2",
        "summary": "Get the venue status",
        "security": [],
        "responses": {
          "200": {
            "description": "Success. The body follows the live OpenAPI document."
          }
        }
      }
    },
    "/v2/auth/capabilities": {
      "get": {
        "operationId": "getAuthCapabilitiesV2",
        "summary": "Get authentication capabilities",
        "security": [],
        "responses": {
          "200": {
            "description": "Success. The body follows the live OpenAPI document."
          }
        }
      }
    },
    "/v2/markets": {
      "get": {
        "operationId": "ccxtV2FetchMarkets",
        "summary": "List all Spot and Perps markets (CCXT shape)",
        "security": [],
        "responses": {
          "200": {
            "description": "Success. The body follows the live OpenAPI document."
          }
        }
      }
    },
    "/v2/spot/markets": {
      "get": {
        "operationId": "ccxtV2FetchMarketsSpot",
        "summary": "List Spot markets (CCXT shape)",
        "security": [],
        "responses": {
          "200": {
            "description": "Success. The body follows the live OpenAPI document."
          }
        }
      }
    },
    "/v2/perps/markets": {
      "get": {
        "operationId": "ccxtV2FetchMarketsPerps",
        "summary": "List Perps markets (CCXT shape)",
        "security": [],
        "responses": {
          "200": {
            "description": "Success. The body follows the live OpenAPI document."
          }
        }
      }
    },
    "/v2/currencies": {
      "get": {
        "operationId": "ccxtV2FetchCurrencies",
        "summary": "List supported currencies (CCXT shape)",
        "security": [],
        "responses": {
          "200": {
            "description": "Success. The body follows the live OpenAPI document."
          }
        }
      }
    },
    "/v2/tickers": {
      "get": {
        "operationId": "ccxtV2FetchTickers",
        "summary": "Get tickers for all or selected markets (CCXT shape)",
        "security": [],
        "responses": {
          "200": {
            "description": "Success. The body follows the live OpenAPI document."
          }
        },
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Optional comma-separated CCXT symbols. Omit it for every tradable market."
          }
        ]
      }
    },
    "/v2/leaderboard": {
      "get": {
        "operationId": "getLeaderboardV2",
        "summary": "Get the projected realized-PnL leaderboard",
        "security": [],
        "responses": {
          "200": {
            "description": "Success. The body follows the live OpenAPI document."
          }
        },
        "parameters": [
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "daily",
                "weekly",
                "monthly",
                "all_time"
              ],
              "default": "daily"
            },
            "description": "UTC ranking window. Defaults to daily."
          },
          {
            "name": "metric",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "projected_realized_pnl"
              ],
              "default": "projected_realized_pnl"
            },
            "description": "Ranked metric. Only projected_realized_pnl is currently proven."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "default": 50
            },
            "description": "Page size, from 1 to 100."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Opaque cursor pinning the board version, the participant view and the last rank."
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "human",
                "bot",
                "agent"
              ]
            },
            "description": "Participant view: all (humans, agents and bots, the default), human, agent or bot."
          }
        ]
      }
    },
    "/v2/markets/{marketId}": {
      "get": {
        "operationId": "getMarketSnapshotV2",
        "summary": "Get a market snapshot",
        "security": [],
        "responses": {
          "200": {
            "description": "Success. The body follows the live OpenAPI document."
          }
        },
        "parameters": [
          {
            "name": "marketId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "/v2/markets/{symbol}/stats": {
      "get": {
        "operationId": "ccxtV2FetchTickerAndFundingRate",
        "summary": "Get market ticker and funding rate (CCXT shape)",
        "security": [],
        "responses": {
          "200": {
            "description": "Success. The body follows the live OpenAPI document."
          }
        },
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "/v2/markets/{symbol}/book": {
      "get": {
        "operationId": "ccxtV2FetchOrderBook",
        "summary": "Get the order book (CCXT shape)",
        "security": [],
        "responses": {
          "200": {
            "description": "Success. The body follows the live OpenAPI document."
          }
        },
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "default": 100
            },
            "description": "Maximum levels per side, from 1 to 500. Defaults to 100."
          }
        ]
      }
    },
    "/v2/markets/{symbol}/candles": {
      "get": {
        "operationId": "ccxtV2FetchOhlcv",
        "summary": "Get market OHLCV candles (CCXT shape)",
        "security": [],
        "responses": {
          "200": {
            "description": "Success. The body follows the live OpenAPI document."
          }
        },
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "timeframe",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1m",
                "3m",
                "5m",
                "15m",
                "30m",
                "1h",
                "2h",
                "4h",
                "8h",
                "12h",
                "1d",
                "3d",
                "1w",
                "1M"
              ],
              "default": "1m"
            },
            "description": "CCXT unified timeframe. Defaults to 1m."
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Optional inclusive Unix timestamp in integer milliseconds."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "default": 100
            },
            "description": "Maximum number of candles, from 1 to 100. Defaults to 100."
          },
          {
            "name": "series",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "trade",
                "index",
                "mark"
              ]
            },
            "description": "Candle source series. Defaults to index."
          },
          {
            "name": "price",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "mid"
              ]
            },
            "description": "Optional CCXT price series selector. Send mid for order book mid candles."
          }
        ]
      }
    },
    "/v2/markets/{symbol}/trades": {
      "get": {
        "operationId": "ccxtV2FetchTrades",
        "summary": "Get recent public trades (CCXT shape)",
        "security": [],
        "responses": {
          "200": {
            "description": "Success. The body follows the live OpenAPI document."
          }
        },
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Optional epoch milliseconds for the oldest trades at or after since."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "default": 50
            },
            "description": "Maximum trades, from 1 to 100. Defaults to 50."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Optional pagination cursor from a previous trade."
          }
        ]
      }
    },
    "/v2/venue/totals": {
      "get": {
        "operationId": "getVenueTotals",
        "summary": "Get venue totals",
        "security": [],
        "responses": {
          "200": {
            "description": "Success. The body follows the live OpenAPI document."
          }
        }
      }
    },
    "/v2/venue/collateral": {
      "get": {
        "operationId": "getVenueCollateral",
        "summary": "Get venue collateral units",
        "security": [],
        "responses": {
          "200": {
            "description": "Success. The body follows the live OpenAPI document."
          }
        }
      }
    }
  }
}
